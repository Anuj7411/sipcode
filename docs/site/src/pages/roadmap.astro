---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import MobileNotice from "../components/MobileNotice.astro";

const base = import.meta.env.BASE_URL;

interface ShippedItem {
  version: string;
  title: string;
  body: string;
}

const shipped: ShippedItem[] = [
  { version: "v1.6.0", title: "Proxy hook with 7 rewriters", body: "PreToolUse input rewriting active. The first valve in the meter-and-valve model." },
  { version: "v1.6.5", title: "Drift detector v2", body: "Persistent baselines, per-project history, MCP config-cause attribution." },
  { version: "v1.6.6", title: "Re-read dedup (B5)", body: "First proxy 'deny + reason' path. Catches re-reads in-session." },
  { version: "v1.6.7", title: "Live --vs-rtk benchmark (B2)", body: "Reproducible comparison harness with Sipcode-only isolation." },
  { version: "v1.6.8", title: "Compression integrity scoring (B4)", body: "Every rewriter declares a 0-1 score. Honesty over polish." },
  { version: "v1.6.10", title: "AST-aware reads (B3) + trend/today/forecast", body: "Symbol-level slicing for TS + Python. 15 MCP tools." },
  { version: "v1.6.13", title: "Pre-launch security hardening", body: "H1 session_id sanitize, H2 ReDoS guard, F2 atomic settings write, H3 CSP, F6 CI minor-bump guard." },
  { version: "v1.6.14", title: "Path-normalization fix", body: "Unifies dedup hook + heuristic walker + topExpensive with drift's analyzer." },
  { version: "v1.6.15", title: "Verified Warm-Fill + sipcode init system-setup", body: "Mid-session install no longer leaves the dedup cache empty. Zero false-dedup risk by construction." },
];

interface CommittedItem {
  tag: string;
  title: string;
  body: string;
  build: string;
}

const committed: CommittedItem[] = [
  {
    tag: "v2.1",
    title: "Predictive context from git co-edit history",
    body: "Sipcode reads `git log --name-only`, builds a co-edit graph, and pre-summarizes files that historically change with the file Claude just read. RTK structurally cannot do this (no git awareness).",
    build: "3 to 4 weeks build cost",
  },
  {
    tag: "v2.2",
    title: "Cross-session context hygiene",
    body: "Today's per-session caches go cross-session. 11AM's session knows what 9AM showed Claude. Drift becomes day-level. Dedup carries across same-project sessions.",
    build: "4 to 6 weeks build cost",
  },
];

interface ResearchItem {
  title: string;
  body: string;
}

const researching: ResearchItem[] = [
  {
    title: "Adaptive context-pressure compression",
    body: "Light compression at 50% context fill, aggressive at 70%, summary-only at 90%. Anthropic is competing here at the model layer with native context editing. We are watching their roadmap 3 to 6 months before committing engineering.",
  },
  {
    title: "Multi-CLI support (Codex, Gemini, others)",
    body: "Each CLI has its own hook system. About 3 to 6 weeks per CLI. Tell us which one to build next by opening a GitHub Discussion.",
  },
  {
    title: "Symbolic anticipation",
    body: "Meta-feature combining drift + AST + git history into 'the next 5 things Claude will need.' Only makes sense after v2.1 and v2.2 ship.",
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Roadmap — Sipcode</title>
  <meta name="description" content="What's shipped, what's committed for v2, what we're researching. Honest about the difference between the three." />
  <link rel="canonical" href="https://anuj7411.github.io/sipcode/roadmap/" />
  <link rel="icon" type="image/png" href={`${base}/favicon-32.png`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <meta name="theme-color" content="#F8F8F6" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <MobileNotice />
  <main id="top">
    <NavBar />

    <section class="rm-hero">
      <div class="container">
        <h1 class="rm-h1">Roadmap</h1>
        <p class="rm-sub">Three tiers. We are honest about which is which.</p>
      </div>
    </section>

    <section class="rm-tier">
      <div class="container">
        <div class="tier-head">
          <span class="tier-label">Tier 1</span>
          <h2 class="tier-h2">Live today</h2>
          <p class="tier-meta">Every item below is shipped to npm and verifiable.</p>
        </div>
        <ul class="tier-list">
          {shipped.map((it) => (
            <li class="tier-item">
              <span class="tier-version">{it.version}</span>
              <div class="tier-body">
                <h3 class="tier-item-h3">{it.title}</h3>
                <p class="tier-item-p">{it.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="rm-tier rm-tier--committed">
      <div class="container">
        <div class="tier-head">
          <span class="tier-label tier-label--committed">Tier 2</span>
          <h2 class="tier-h2">Committed for v2</h2>
          <p class="tier-meta">Scoped, dated, and on our build plan. If we slip, we owe you a postmortem.</p>
        </div>
        <ul class="tier-list">
          {committed.map((it) => (
            <li class="tier-item">
              <span class="tier-version">{it.tag}</span>
              <div class="tier-body">
                <h3 class="tier-item-h3">{it.title}</h3>
                <p class="tier-item-p">{it.body}</p>
                <p class="tier-build">{it.build}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="rm-tier rm-tier--research">
      <div class="container">
        <div class="tier-head">
          <span class="tier-label tier-label--research">Tier 3</span>
          <h2 class="tier-h2">Researching</h2>
          <p class="tier-meta">No date, no commitment. We will commit when we can defend the claim.</p>
        </div>
        <ul class="tier-list">
          {researching.map((it) => (
            <li class="tier-item tier-item--research">
              <div class="tier-body">
                <h3 class="tier-item-h3">{it.title}</h3>
                <p class="tier-item-p">{it.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="rm-cta">
      <div class="container">
        <a href={`${base}/`} class="btn-ghost">← back to home</a>
        <a href="https://github.com/Anuj7411/sipcode" class="btn-primary" target="_blank" rel="noopener">vote on GitHub Discussions →</a>
      </div>
    </section>

    <Footer />
  </main>
</body>
</html>

<style>
  .rm-hero {
    padding: 56px 0 24px;
    background: var(--paper, #F8F8F6);
    border-bottom: 1px solid rgba(10,10,10,0.08);
  }
  .rm-hero .container,
  .rm-tier .container,
  .rm-cta .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .rm-h1 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(32px, 4.5vw, 52px);
    letter-spacing: -0.035em;
    color: #0A0A0A;
    margin: 0 0 12px;
    line-height: 1.04;
  }
  .rm-sub {
    font-family: "Inter", system-ui, sans-serif;
    font-size: clamp(15px, 1.4vw, 17px);
    color: #2D3142;
    margin: 0;
  }

  .rm-tier {
    padding: 48px 0;
    background: var(--paper, #F8F8F6);
    border-top: 1px solid rgba(10,10,10,0.06);
  }
  .rm-tier--committed { background: #F4F2EE; }
  .rm-tier--research  { background: #EFEEEA; }

  .tier-head { margin-bottom: 24px; }
  .tier-label {
    display: inline-block;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #5B4FCF;
    padding: 4px 10px;
    border: 1px solid rgba(91,79,207,0.3);
    border-radius: 4px;
    background: rgba(91,79,207,0.06);
  }
  .tier-label--committed { color: #B9831B; border-color: rgba(185,131,27,0.3); background: rgba(185,131,27,0.06); }
  .tier-label--research  { color: #2D3142; border-color: rgba(45,49,66,0.3); background: rgba(45,49,66,0.06); }

  .tier-h2 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(24px, 2.8vw, 32px);
    letter-spacing: -0.025em;
    color: #0A0A0A;
    margin: 14px 0 6px;
  }
  .tier-meta {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 14.5px;
    color: #2D3142;
    margin: 0;
  }
  .tier-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .tier-item {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 18px;
    padding: 18px 20px;
    background: #fff;
    border: 1px solid rgba(10,10,10,0.1);
    border-radius: 8px;
  }
  .tier-item--research { grid-template-columns: 1fr; }
  .tier-version {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    color: #5B4FCF;
    padding-top: 2px;
  }
  .tier-item-h3 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
    font-size: 16.5px;
    letter-spacing: -0.015em;
    color: #0A0A0A;
    margin: 0 0 6px;
  }
  .tier-item-p {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 14.5px;
    line-height: 1.55;
    color: #2D3142;
    margin: 0;
  }
  .tier-build {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: #B9831B;
    margin: 8px 0 0;
  }

  .rm-cta {
    padding: 56px 0 80px;
    background: var(--paper, #F8F8F6);
    border-top: 1px solid rgba(10,10,10,0.08);
  }
  .rm-cta .container {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .rm-cta .btn-primary,
  .rm-cta .btn-ghost {
    display: inline-block;
    padding: 9px 18px;
    border-radius: 10px;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: transform 120ms ease;
  }
  .rm-cta .btn-primary { background: #5B4FCF; color: #fff; border: 1px solid #5B4FCF; }
  .rm-cta .btn-ghost { background: transparent; color: #0A0A0A; border: 1px solid rgba(10,10,10,0.18); }
  .rm-cta a:hover { transform: translateY(-1px); }
</style>
