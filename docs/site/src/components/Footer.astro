---
// Footer — dark ink ground. Three columns max. No newsletter form, no six
// columns, no social icon row for platforms we don't post on.
---

<footer class="footer">
  <div class="container">

    <div class="cols">

      <div class="col col--brand">
        <a href="#top" class="brand" aria-label="Sipcode — back to top">
          <span class="brand-mark" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 100 100">
              <path d="M85 50 q0 35 -35 35 q-35 0 -35 -35 q0 -35 35 -35 q35 0 35 35Z"
                fill="none" stroke="#fff" stroke-width="7" stroke-linejoin="round"/>
              <path d="M15 60 q35 5 70 0 L85 85 q0 0 -35 0 q-35 0 -35 0 Z" fill="#7A6FE3"/>
            </svg>
          </span>
          <span class="brand-word">
            <span class="brand-sip">sip</span><span class="brand-code">code</span>
          </span>
        </a>
        <p class="brand-tag">Sip your tokens. Don't gulp them.</p>
        <div class="badges">
          <span class="badge">
            <span class="badge-dot"></span>
            v1.6.11
          </span>
          <span class="badge">
            <span class="badge-dot badge-dot--green"></span>
            1247 tests passing
          </span>
        </div>
      </div>

      <div class="col">
        <h3 class="col-head">Docs</h3>
        <ul class="links">
          <li><a href="https://github.com/Anuj7411/sipcode#readme" target="_blank" rel="noopener">Quickstart</a></li>
          <li><a href="https://github.com/Anuj7411/sipcode/blob/main/docs/MCP.md" target="_blank" rel="noopener">MCP guide</a></li>
          <li><a href="https://github.com/Anuj7411/sipcode/blob/main/benchmark/METHODOLOGY.md" target="_blank" rel="noopener">Benchmark methodology</a></li>
        </ul>
      </div>

      <div class="col">
        <h3 class="col-head">Project</h3>
        <ul class="links">
          <li><a href="https://github.com/Anuj7411/sipcode" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://www.npmjs.com/package/sipcode" target="_blank" rel="noopener">npm</a></li>
          <li><a href="https://github.com/Anuj7411/sipcode/issues" target="_blank" rel="noopener">Issues</a></li>
        </ul>
      </div>

    </div>

    <div class="legal">
      <span>Built by <a href="https://github.com/Anuj7411" target="_blank" rel="noopener">Anuj Ojha</a></span>
      <span>·</span>
      <span>MIT licensed</span>
      <span>·</span>
      <span>© 2026</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #121218;
    color: rgba(255, 255, 255, .72);
    padding: clamp(40px, 6vh, 64px) 0 clamp(24px, 3vh, 36px);
    border-top: 1px solid rgba(255, 255, 255, .06);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, .08);
  }
  @media (min-width: 760px) {
    .cols { grid-template-columns: 1.4fr 1fr 1fr; gap: 48px; }
  }

  .col--brand { max-width: 320px; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .brand-mark { flex: 0 0 auto; }
  .brand-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -.03em;
    line-height: 1;
  }
  .brand-sip { color: #fff; }
  .brand-code { color: #7A6FE3; }

  .brand-tag {
    margin: 16px 0 18px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, .55);
  }

  .badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, .6);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 999px;
    padding: 4px 12px;
  }
  .badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .45);
    flex: 0 0 auto;
  }
  .badge-dot--green { background: #2BB673; box-shadow: 0 0 0 3px rgba(43, 182, 115, .2); }

  .col-head {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .42);
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .links a {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: rgba(255, 255, 255, .72);
    text-decoration: none;
    width: fit-content;
    transition: color .15s var(--ease-quint);
  }
  .links a:hover { color: #A99CF7; }

  .legal {
    margin-top: 22px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(255, 255, 255, .42);
  }
  .legal a {
    color: rgba(255, 255, 255, .68);
    text-decoration: none;
    transition: color .15s var(--ease-quint);
  }
  .legal a:hover { color: #A99CF7; }
</style>
