{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.anuj7411/sipcode",
  "title": "Sipcode",
  "description": "Keep Claude Code's context clean: drift detection, re-read dedup, integrity scoring, and token analytics. Makes zero network calls in normal use.",
  "repository": {
    "url": "https://github.com/Anuj7411/sipcode",
    "source": "github"
  },
  "version": "1.6.17",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "sipcode",
      "version": "1.6.17",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        { "type": "named", "name": "-y" },
        { "type": "named", "name": "-p", "value": "sipcode" }
      ],
      "packageArguments": [
        { "type": "positional", "valueHint": "bin_name", "value": "sipcode-mcp" }
      ]
    }
  ]
}
